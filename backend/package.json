{
  "type": "module",
  "name": "task-manager-api",
  "version": "1.0.0",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "migrate": "tsx src/db/migrate.ts",
    "reset": "tsx src/db/reset.ts",
    "lint": "eslint src tests"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.11.3",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.5.3"
  },
 "devDependencies": {
   "@eslint/js": "^10.0.1",
   "@types/bcryptjs": "^2.4.6",
   "@types/cors": "^2.8.17",
   "@types/express": "^5.0.6",
   "@types/jsonwebtoken": "^9.0.10",
   "@types/node": "^26.6.5",
   "@types/pg": "^8.23.1",
   "@types/supertest": "^7.2.1",
   "@types/swagger-jsdoc": "^6.0.4",
   "@types/swagger-ui-express": "^4.1.8",
   "eslint": "^10.13.0",
   "nodemon": "^3.1.9",
   "supertest": "^7.2.2",
   "tsx": "^4.23.15",
   "typescript": "^5.7.0",
   "vitest": "^4.1.11",
   "typescript-eslint": "^8.0.0",
   "globals": "^15.0.0"
  }
